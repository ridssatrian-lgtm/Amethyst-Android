<?xml version="1.0" encoding="utf-8" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/nev_red_pressed" />
            <stroke android:width="2dp" android:color="@color/nev_yellow" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#4A2323" />
            <stroke android:width="2dp" android:color="#6B3A3A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/nev_red"
                android:endColor="@color/nev_red_dark" />
            <stroke android:width="2dp" android:color="@color/nev_yellow" />
        </shape>
    </item>
</selector>
